# GENERATED by artix_m2_canfd/gen/xdc.py from the routed board: do not edit.
# Processed before the PCIe IP's own constraints (PROCESSING_ORDER EARLY).
# M.2 lane n is on GTP channel 3-n; the transmit pairs are polarity-swapped on the board,
# which the host corrects in link training, so txp stays on the MGTPTXP ball.
set_property LOC GTPE2_CHANNEL_X0Y3 [get_cells -hierarchical -regexp {.*pipe_lane\[0\]\.gt_wrapper_i/gtp_channel\.gtpe2_channel_i}]
set_property LOC GTPE2_CHANNEL_X0Y2 [get_cells -hierarchical -regexp {.*pipe_lane\[1\]\.gt_wrapper_i/gtp_channel\.gtpe2_channel_i}]
set_property LOC GTPE2_CHANNEL_X0Y1 [get_cells -hierarchical -regexp {.*pipe_lane\[2\]\.gt_wrapper_i/gtp_channel\.gtpe2_channel_i}]
set_property LOC GTPE2_CHANNEL_X0Y0 [get_cells -hierarchical -regexp {.*pipe_lane\[3\]\.gt_wrapper_i/gtp_channel\.gtpe2_channel_i}]

set_property PACKAGE_PIN G4  [get_ports {pcie_mgt_rxp[0]}]
set_property PACKAGE_PIN G3  [get_ports {pcie_mgt_rxn[0]}]
set_property PACKAGE_PIN B2  [get_ports {pcie_mgt_txp[0]}]   ;# board: PERn (swapped)
set_property PACKAGE_PIN B1  [get_ports {pcie_mgt_txn[0]}]
set_property PACKAGE_PIN C4  [get_ports {pcie_mgt_rxp[1]}]
set_property PACKAGE_PIN C3  [get_ports {pcie_mgt_rxn[1]}]
set_property PACKAGE_PIN D2  [get_ports {pcie_mgt_txp[1]}]   ;# board: PERn (swapped)
set_property PACKAGE_PIN D1  [get_ports {pcie_mgt_txn[1]}]
set_property PACKAGE_PIN A4  [get_ports {pcie_mgt_rxp[2]}]
set_property PACKAGE_PIN A3  [get_ports {pcie_mgt_rxn[2]}]
set_property PACKAGE_PIN F2  [get_ports {pcie_mgt_txp[2]}]   ;# board: PERn (swapped)
set_property PACKAGE_PIN F1  [get_ports {pcie_mgt_txn[2]}]
set_property PACKAGE_PIN E4  [get_ports {pcie_mgt_rxp[3]}]
set_property PACKAGE_PIN E3  [get_ports {pcie_mgt_rxn[3]}]
set_property PACKAGE_PIN H2  [get_ports {pcie_mgt_txp[3]}]   ;# board: PERn (swapped)
set_property PACKAGE_PIN H1  [get_ports {pcie_mgt_txn[3]}]

# 100 MHz PCIe reference clock from the M.2 connector (MGTREFCLK0, not inverted)
set_property PACKAGE_PIN D6 [get_ports pcie_refclk_clk_p]
set_property PACKAGE_PIN D5 [get_ports pcie_refclk_clk_n]
create_clock -period 10.000 -name pcie_refclk [get_ports pcie_refclk_clk_p]
