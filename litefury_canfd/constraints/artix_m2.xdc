# GENERATED by artix_m2_canfd/gen/xdc.py from the routed board: do not edit.
# artix_m2_canfd card (XC7A50T-2CSG325I) pins. Processed after the IP constraints (PROCESSING_ORDER LATE).

## 100 MHz oscillator on an MRCC pin (the block design creates the clock)
set_property -dict {PACKAGE_PIN E13 IOSTANDARD LVCMOS33} [get_ports sys_clk]

## PCIe reset from the M.2 connector
set_property -dict {PACKAGE_PIN E15 IOSTANDARD LVCMOS33} [get_ports pcie_perst_n]
set_false_path -from [get_ports pcie_perst_n]

## User LEDs (active low: 1k to 3.3 V)
set_property -dict {PACKAGE_PIN U2  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {leds[0]}]
set_property -dict {PACKAGE_PIN V2  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {leds[1]}]
set_property -dict {PACKAGE_PIN K3  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {leds[2]}]
set_property -dict {PACKAGE_PIN L3  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {leds[3]}]

## CAN transceivers (MCP2542FD), one per CAN core. With CAN_CORES < 4 the design holds the
## spare ones recessive and in standby; their RXD pins are then unused (pulled up, see UNUSEDPIN).
set_property -dict {PACKAGE_PIN K1  IOSTANDARD LVCMOS33 DRIVE 8 SLEW FAST} [get_ports can0_tx]
set_property -dict {PACKAGE_PIN M1  IOSTANDARD LVCMOS33 PULLUP true} [get_ports can0_rx]
set_property -dict {PACKAGE_PIN N1  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports can0_stby]
set_property -dict {PACKAGE_PIN P1  IOSTANDARD LVCMOS33 DRIVE 8 SLEW FAST} [get_ports can1_tx]
set_property -dict {PACKAGE_PIN R1  IOSTANDARD LVCMOS33 PULLUP true} [get_ports can1_rx]
set_property -dict {PACKAGE_PIN U1  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports can1_stby]
set_property -dict {PACKAGE_PIN K2  IOSTANDARD LVCMOS33 DRIVE 8 SLEW FAST} [get_ports can2_tx]
set_property -dict {PACKAGE_PIN L2  IOSTANDARD LVCMOS33 PULLUP true} [get_ports can2_rx]
set_property -dict {PACKAGE_PIN M2  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports can2_stby]
set_property -dict {PACKAGE_PIN N2  IOSTANDARD LVCMOS33 DRIVE 8 SLEW FAST} [get_ports can3_tx]
set_property -dict {PACKAGE_PIN R2  IOSTANDARD LVCMOS33 PULLUP true} [get_ports can3_rx]
set_property -dict {PACKAGE_PIN T2  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports can3_stby]
set_false_path -to   [get_ports {can*_tx can*_stby leds[*]}]
set_false_path -from [get_ports -quiet can*_rx]

## Configuration: QSPI x4 from the W25Q128JV, internal config clock, compressed bitstream
## (fast enough for PCIe to enumerate). Banks 0 and 14 are at 3.3 V.
set_property BITSTREAM.CONFIG.OVERTEMPPOWERDOWN ENABLE [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 33 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE YES [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLUP [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]
